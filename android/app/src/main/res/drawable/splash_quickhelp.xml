<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla de carga: rojo de la marca con el logo centrado (sin deformarse). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#F52B43"
                android:endColor="#CF102C" />
        </shape>
    </item>
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
