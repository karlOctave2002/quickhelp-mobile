<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Widget de emergencia de la pantalla de inicio. -->
        <receiver
            android:name="cl.quickhelp.WidgetEmergenciaProvider"
            android:exported="true"
            android:label="Emergencia Quick Help">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_emergencia_info" />
        </receiver>

        <!-- Cuenta regresiva y envío de la SOS desde el widget, sin abrir la app. -->
        <service
            android:name="cl.quickhelp.WidgetEmergenciaService"
            android:exported="false"
            android:foregroundServiceType="location|shortService" />

        <!-- Botón SOS en el panel rápido de Android (misma cuenta regresiva). -->
        <service
            android:name="cl.quickhelp.WidgetEmergenciaTile"
            android:exported="true"
            android:icon="@drawable/ic_tile_sos"
            android:label="SOS Quick Help"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Activación por voz: escucha la frase clave aunque la app esté cerrada. -->
        <service
            android:name="cl.quickhelp.VozEmergenciaService"
            android:exported="false"
            android:foregroundServiceType="microphone|location" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Ubicación GPS para la dirección de Inicio y las coordenadas de la SOS. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <!-- Widget de emergencia: servicio en primer plano y vibración. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Activación por voz: micrófono en segundo plano con notificación fija. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- Android 11+: permite usar la voz del teléfono (texto a voz) para los avisos hablados. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>
</manifest>
